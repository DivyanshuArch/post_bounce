; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Moonlit Ricochet"
run/main_scene="res://scenes/splash_screen.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/image="uid://iashe0qr1asn"
config/icon="res://icon.svg"

[autoload]

SoundManager="*res://scripts/sound_manager.gd"
GameSettings="*res://scripts/game_settings.gd"
SceneManager="*res://scripts/scene_manager.gd"
NetworkManager="*res://scripts/network_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.129412, 0.172549, 0.14902, 1)
